# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
START HigherLowerGame

    // Step 1: Declare variables
    DECLARE lowerBound AS INTEGER
    DECLARE upperBound AS INTEGER
    DECLARE targetNumber AS INTEGER
    DECLARE userGuess AS INTEGER
    DECLARE isGuessed AS BOOLEAN
    
    SET isGuessed = FALSE

    // Step 2: Greeting
    PRINT "Welcome to the higher/lower game, Bella!"

    // Step 3: Get and validate bounds from the user
    REPEAT
        PRINT "Enter the lower bound:"
        READ lowerBound
        
        PRINT "Enter the upper bound:"
        READ upperBound
        
        IF lowerBound >= upperBound THEN
            PRINT "The lower bound must be less than the upper bound."
        ENDIF
    UNTIL lowerBound < upperBound

    // Step 4: Generate the random target number in range [lowerBound, upperBound]
    targetNumber = GENERATE_RANDOM_INTEGER(lowerBound, upperBound)

    // Step 5: Initial guess prompt
    PRINT "Great, now guess a number between " + lowerBound + " and " + upperBound + ":"
    READ userGuess

    // Step 6: Main game loop
    WHILE isGuessed == FALSE DO
        
        // Input validation for guess range
        IF userGuess < lowerBound OR userGuess > upperBound THEN
            PRINT "Nope, too high." // or prompt to enter a valid number within bounds
        ENDIF

        // Decision branching for the guess
        IF userGuess < targetNumber THEN
            PRINT "Nope, too low."
            PRINT "Guess another number:"
            READ userGuess
        ELSE IF userGuess > targetNumber THEN
            PRINT "Nope, too high."
            PRINT "Guess another number:"
            READ userGuess
        ELSE
            PRINT "You got it!"
            SET isGuessed = TRUE

END hilow_game
